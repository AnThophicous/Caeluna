post_install() {
    command -v update-desktop-database >/dev/null 2>&1 &&
        update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
}

post_upgrade() {
    post_install
}

pre_remove() {
    # Never stop a running session or remove user settings during a transaction.
    :
}

post_remove() {
    command -v update-desktop-database >/dev/null 2>&1 &&
        update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
}
